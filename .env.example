# Copy to .env. Existing environment variables take precedence.
PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
# Prefer a supported GA API version. Keep your actual KB endpoint if different.
RAG_MCP_ENDPOINT=https://your-search.search.windows.net/knowledgebases/your-kb/mcp?api-version=2026-04-01
PROJECT_CONNECTION_NAME=my-kb-connection
AGENT_NAME=RagAgent
MODEL_DEPLOYMENT=gpt-4.1-mini

# Pin a tested version for clients; blank uses deployment.json.
AGENT_VERSION=
DEPLOYMENT_FILE=deployment.json

# default: Entra credential chain; cli: local/CI az login; managed_identity: Azure runtime.
AZURE_CREDENTIAL_MODE=default
# For a user-assigned runtime identity only (distinct from CI AZURE_CLIENT_ID).
MANAGED_IDENTITY_CLIENT_ID=

REQUEST_TIMEOUT_SECONDS=120
MAX_OUTPUT_TOKENS=2048
MAX_QUESTION_CHARS=8000
HISTORY_TURNS=6
