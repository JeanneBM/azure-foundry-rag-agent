# Copy to .env. Existing environment variables take precedence.
PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
# MCP uses a supported preview API, separately from the GA index/KB provisioning API.
RAG_MCP_ENDPOINT=https://your-search.search.windows.net/knowledgebases/your-kb/mcp?api-version=2026-08-01-preview
PROJECT_CONNECTION_NAME=my-kb-connection
AGENT_NAME=RagAgent
MODEL_DEPLOYMENT=gpt-4.1-mini

# Pin a tested version for clients; blank uses deployment.json.
AGENT_VERSION=
DEPLOYMENT_FILE=deployment.json

# default: Entra credential chain; cli: local az login; managed_identity: Azure runtime.
AZURE_CREDENTIAL_MODE=default
# Optional subscription name/ID for cli mode; does not change the az default.
AZURE_CLI_SUBSCRIPTION=
# For a user-assigned runtime identity only. CI has no Azure identity.
MANAGED_IDENTITY_CLIENT_ID=

REQUEST_TIMEOUT_SECONDS=120
MAX_OUTPUT_TOKENS=2048
MAX_QUESTION_CHARS=8000
HISTORY_TURNS=6
# Optional interactive introduction; blank uses a generic knowledge-base welcome.
CHAT_WELCOME=
